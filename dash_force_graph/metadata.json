{
  "src/ForceGraph.js": {
    "description": "A high-performance graph visualization component using force-graph.",
    "displayName": "ForceGraph",
    "methods": [],
    "props": {
      "id": {
        "description": "The ID of this component",
        "type": {"name": "string"},
        "required": false
      },
      "nodes": {
        "description": "List of node objects. Each node should have at least 'id'. Optional: 'label', 'color', 'connections'.",
        "type": {"name": "array"},
        "required": false,
        "defaultValue": {"value": "[]", "computed": false}
      },
      "links": {
        "description": "List of link objects. Each link needs 'source' and 'target' (node IDs).",
        "type": {"name": "array"},
        "required": false,
        "defaultValue": {"value": "[]", "computed": false}
      },
      "selectedNodes": {
        "description": "List of currently selected node IDs.",
        "type": {"name": "array"},
        "required": false,
        "defaultValue": {"value": "[]", "computed": false}
      },
      "width": {
        "description": "Width of the graph container in pixels.",
        "type": {"name": "number"},
        "required": false
      },
      "height": {
        "description": "Height of the graph container in pixels.",
        "type": {"name": "number"},
        "required": false
      },
      "nodeColor": {
        "description": "Default color for nodes (when node.color is not set).",
        "type": {"name": "string"},
        "required": false
      },
      "linkColor": {
        "description": "Default color for links.",
        "type": {"name": "string"},
        "required": false,
        "defaultValue": {"value": "'rgba(150, 150, 150, 0.2)'", "computed": false}
      },
      "linkWidth": {
        "description": "Default width for links.",
        "type": {"name": "number"},
        "required": false,
        "defaultValue": {"value": "0.5", "computed": false}
      },
      "enableZoom": {
        "description": "Enable zoom interaction.",
        "type": {"name": "bool"},
        "required": false,
        "defaultValue": {"value": "true", "computed": false}
      },
      "enablePan": {
        "description": "Enable pan interaction.",
        "type": {"name": "bool"},
        "required": false,
        "defaultValue": {"value": "true", "computed": false}
      },
      "enableNodeDrag": {
        "description": "Enable node dragging. Automatically disabled in performance mode.",
        "type": {"name": "bool"},
        "required": false,
        "defaultValue": {"value": "true", "computed": false}
      },
      "cooldownTicks": {
        "description": "Simulation ticks before stopping.",
        "type": {"name": "number"},
        "required": false,
        "defaultValue": {"value": "100", "computed": false}
      },
      "centerAt": {
        "description": "Node ID to center the view on.",
        "type": {"name": "string"},
        "required": false
      },
      "zoomLevel": {
        "description": "Zoom level to apply.",
        "type": {"name": "number"},
        "required": false
      },
      "fitView": {
        "description": "Increment this counter to trigger a zoomToFit after the simulation settles.",
        "type": {"name": "number"},
        "required": false,
        "defaultValue": {"value": "0", "computed": false}
      },
      "mode": {
        "description": "Rendering mode: 'interactive' (full features) or 'performance' (optimized for large graphs).",
        "type": {"name": "string"},
        "required": false,
        "defaultValue": {"value": "'interactive'", "computed": false}
      },
      "chargeStrength": {
        "description": "Charge force strength. Negative values repel nodes. Weakened in performance mode.",
        "type": {"name": "number"},
        "required": false,
        "defaultValue": {"value": "-50", "computed": false}
      },
      "linkDistance": {
        "description": "Target distance between linked nodes.",
        "type": {"name": "number"},
        "required": false,
        "defaultValue": {"value": "30", "computed": false}
      },
      "collisionRadius": {
        "description": "Collision detection radius. Null disables collision force.",
        "type": {"name": "number"},
        "required": false,
        "defaultValue": {"value": "null", "computed": true}
      },
      "d3AlphaDecay": {
        "description": "Simulation alpha decay rate. Lower values run the simulation longer.",
        "type": {"name": "number"},
        "required": false,
        "defaultValue": {"value": "0.0228", "computed": false}
      },
      "d3VelocityDecay": {
        "description": "Simulation velocity decay rate. Controls node inertia.",
        "type": {"name": "number"},
        "required": false,
        "defaultValue": {"value": "0.4", "computed": false}
      },
      "nodeRelSize": {
        "description": "Node size relative to its value. Scaled down in performance mode.",
        "type": {"name": "number"},
        "required": false,
        "defaultValue": {"value": "6", "computed": false}
      },
      "selectedColor": {
        "description": "Highlight color for selected nodes.",
        "type": {"name": "string"},
        "required": false,
        "defaultValue": {"value": "'#ffd93d'", "computed": false}
      },
      "linkDirectionalArrowLength": {
        "description": "Length of directional arrows on links. 0 hides arrows.",
        "type": {"name": "number"},
        "required": false,
        "defaultValue": {"value": "0", "computed": false}
      },
      "linkDirectionalArrowRelPos": {
        "description": "Position of directional arrow along the link (0-1).",
        "type": {"name": "number"},
        "required": false,
        "defaultValue": {"value": "0.5", "computed": false}
      },
      "boxSelectColor": {
        "description": "Color for the box selection rectangle.",
        "type": {"name": "string"},
        "required": false,
        "defaultValue": {"value": "'#1a73e8'", "computed": false}
      },
      "rightClickedNode": {
        "description": "ID of the last right-clicked node (read-only).",
        "type": {"name": "string"},
        "required": false
      },
      "rightClickPosition": {
        "description": "Position {x, y} of the last right-click (read-only).",
        "type": {"name": "object"},
        "required": false
      },
      "setProps": {
        "description": "Dash callback to update props.",
        "type": {"name": "func"},
        "required": false
      }
    }
  }
}
